# Variables lues par seo-automation — inventaire complet dans src/config/env.ts (SPEC).
# `.env` prime sur le shell (override) et n'entre JAMAIS dans git.

# --- Supabase (obligatoire partout) ---------------------------------------
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# Management API — seulement pour scripts/run-migration.ts
SUPABASE_ACCESS_TOKEN=sbp_...

# --- Telegram (bot + notifications ; inutile pour le crawl) ----------------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Chat admin : alertes, /status, /seo…
TELEGRAM_CHAT_ID=6240980049
# Groupes clients : "chatId:siteKey,chatId:siteKey"
TELEGRAM_GROUP_SITES=-100123456:voitures,-100789012:restaurant
# Chats nommés par site dans site_profiles.telegram_chat_env (lecture dynamique)
TELEGRAM_CHAT_VOITURES=-100123456
TELEGRAM_CHAT_RESTAURANT=-100789012
TELEGRAM_CHAT_OKAZ=-100...

# --- Google Search Console ------------------------------------------------
# Service account (recommandé) : fichier JSON ignoré par git
GSC_SERVICE_ACCOUNT_PATH=./config/gsc-service-account.json
# OAuth2 historique — scripts/gsc-auth.ts seulement
GSC_CLIENT_ID=xxx.apps.googleusercontent.com
GSC_CLIENT_SECRET=GOCSPX-...
GSC_REFRESH_TOKEN=1//...

# --- DataForSEO (mots-clés, SERP, backlinks) -------------------------------
DATAFORSEO_LOGIN=login@example.com
DATAFORSEO_PASSWORD=...

# --- Anthropic (optionnel : plus utilisé par les jobs, scripts seulement) --
ANTHROPIC_API_KEY=sk-ant-...

# --- Vercel : un hook par site, nom porté par site_profiles.vercel_hook_env -
VERCEL_HOOK_GARAGE=https://api.vercel.com/v1/integrations/deploy/...
VERCEL_HOOK_CARROSSERIE=https://api.vercel.com/v1/integrations/deploy/...
VERCEL_HOOK_VTC=https://api.vercel.com/v1/integrations/deploy/...
VERCEL_HOOK_VOITURES=https://api.vercel.com/v1/integrations/deploy/...
VERCEL_HOOK_RESTAURANT=https://api.vercel.com/v1/integrations/deploy/...
VERCEL_HOOK_OKAZ=https://api.vercel.com/v1/integrations/deploy/...

# --- Bot : boucle de monitoring -------------------------------------------
UPTIME_CHECK_INTERVAL=300000
# Niveau de log : debug | info | warn | error (défaut info)
LOG_LEVEL=info
